# Force LF line endings for shell scripts (required for Linux execution)
*.sh text eol=lf

# Other common files that should use LF
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# Playwright visual regression snapshot baselines via Git LFS
e2e/tests/visual/**/*-snapshots/** filter=lfs diff=lfs merge=lfs -text
